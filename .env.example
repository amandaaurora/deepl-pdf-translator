# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables instead.

# The password for the site, and a long random string used to sign the
# login cookie (e.g. from `openssl rand -base64 32`). Changing either signs
# you out everywhere.
SITE_PASSWORD=
SESSION_SECRET=

# Your DeepL keys. Free keys end in ":fx". Labels are optional.
DEEPL_API_KEY_1=
DEEPL_API_KEY_1_LABEL=Personal
DEEPL_API_KEY_2=
DEEPL_API_KEY_2_LABEL=Work

# Set automatically when you connect a Vercel Blob store (see README).
# BLOB_READ_WRITE_TOKEN=
